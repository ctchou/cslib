module

public import Cslib.Init
public import Mathlib.Algebra.Order.Kleene
public import Mathlib.Algebra.Order.Sub.Defs
public import Mathlib.Algebra.Star.Basic
public import Mathlib.Data.Set.Lattice.Image

/-!
# Languages over a monoid

This file generalizes `Cslib.Language` (in `Cslib.Computability.Languages.Language`)
from sets of lists over an alphabet to sets of elements of an arbitrary monoid `M`.
The list `[]` is replaced by `1` and concatenation `(· ++ ·)` by multiplication `(· * ·)`.

Union and multiplication define a [Kleene algebra](https://en.wikipedia.org/wiki/Kleene_algebra)
over the languages for any monoid.  The remaining results need extra hypotheses on `M`,
all of which hold for free monoids:

* The `sub_one` lemmas (`sub_one_mul`, `mul_sub_one`, `kstar_sub_one`) assume that `1` has no
  nontrivial factorization, i.e., `u * v = 1 → u = 1 ∧ v = 1`.  This is expressed by the Mathlib
  typeclasses `[IsDedekindFiniteMonoid M] [Subsingleton Mˣ]` (see `mul_eq_one`).  Without it,
  all three lemmas fail: take `l = {u, v}` with `u * v = 1` and `u ≠ 1`.
* Arden's lemma (`self_eq_mul_add_iff`) assumes that `StrictRightFactor` is well-founded,
  and its mirror image (`self_eq_add_mul_iff`) assumes that `StrictLeftFactor` is well-founded.
  Each condition is also necessary for the corresponding lemma.
* Reversal assumes an involutive anti-automorphism of `M`, given by `[StarMul M]`.

## Notation

* `l + m`: union of languages `l` and `m`
* `l - m`: difference of languages `l` and `m`
* `l * m`: language of elements `x * y` such that `x ∈ l` and `y ∈ m`
* `l ^ n`: language of products of `n` members of `l`
* `1`: language consisting of only the element `1`
* `l∗`: Kleene star – language of products of arbitrarily many members of `l`,
  i.e., the submonoid generated by `l`
* `lᶜ`: complement, language of elements `x` such that `x ∉ l`
* `l ⊓ m`: intersection of languages `l` and `m`

## Main definitions

* `MonoidLanguage M`: a set of elements of the monoid `M`
* `l.map f`: transform a language `l` over `M` into a language over `N`
  through a monoid homomorphism `f : M →* N`
* `l.reverse`: the image of `l` under the involutive anti-automorphism `star`
* `StrictRightFactor y x`, `StrictLeftFactor y x`: `x = a * y`, resp. `x = y * a`, for some `a ≠ 1`

## Main theorems

* `MonoidLanguage.self_eq_mul_add_iff`: Arden's lemma – if `StrictRightFactor` is well-founded,
  a language `l` satisfies the equation `l = m * l + n`, and `1 ∉ m`, then `l = m∗ * n`
* `MonoidLanguage.self_eq_add_mul_iff`: the mirror image of Arden's lemma

## Historical note

The definitions and proofs in this file are adapted from `Cslib.Computability.Languages.Language`.
-/

@[expose] public section

open List Set

open scoped Computability

universe v

variable {M N P : Type*}

namespace Cslib

/-- A monoid language is a set of elements of a monoid. -/
def MonoidLanguage (M : Type*) :=
  Set M
deriving CompleteAtomicBooleanAlgebra

namespace MonoidLanguage

instance : Membership M (MonoidLanguage M) := ⟨Set.Mem⟩
instance : Singleton M (MonoidLanguage M) := ⟨Set.singleton⟩
instance : Insert M (MonoidLanguage M) := ⟨Set.insert⟩

variable {l m : MonoidLanguage M} {a b x : M}

/-- The set of elements in a language. -/
def toSet (l : MonoidLanguage M) : Set M := l

/-! ## Results that do not depend on the monoid structure -/

/-- Zero language has no elements. -/
instance : Zero (MonoidLanguage M) :=
  ⟨(∅ : Set _)⟩

instance : Inhabited (MonoidLanguage M) := ⟨(∅ : Set _)⟩

/-- The sum of two languages is their union. -/
instance : Add (MonoidLanguage M) :=
  ⟨((· ∪ ·) : Set M → Set M → Set M)⟩

/-- The subtraction of two languages is their difference. -/
instance : Sub (MonoidLanguage M) where
  sub := SDiff.sdiff

theorem zero_def : (0 : MonoidLanguage M) = (∅ : Set _) :=
  rfl

theorem add_def (l m : MonoidLanguage M) : l + m = (l ∪ m : Set M) :=
  rfl

theorem sub_def (l m : MonoidLanguage M) : l - m = (l \ m : Set M) :=
  rfl

@[ext]
theorem ext {l m : MonoidLanguage M} (h : ∀ (x : M), x ∈ l ↔ x ∈ m) : l = m :=
  Set.ext h

@[simp]
theorem notMem_zero (x : M) : x ∉ (0 : MonoidLanguage M) :=
  id

theorem mem_add (l m : MonoidLanguage M) (x : M) : x ∈ l + m ↔ x ∈ l ∨ x ∈ m :=
  Iff.rfl

theorem mem_sub (l m : MonoidLanguage M) (x : M) : x ∈ l - m ↔ x ∈ l ∧ x ∉ m :=
  Iff.rfl

instance : OrderedSub (MonoidLanguage M) where
  tsub_le_iff_right _ _ _ := sdiff_le_iff'

@[simp]
theorem add_self (l : MonoidLanguage M) : l + l = l :=
  sup_idem _

theorem le_iff (l m : MonoidLanguage M) : l ≤ m ↔ l + m = m :=
  sup_eq_right.symm

theorem mem_iSup {ι : Sort v} {l : ι → MonoidLanguage M} {x : M} :
    (x ∈ ⨆ i, l i) ↔ ∃ i, x ∈ l i :=
  mem_iUnion

theorem iSup_add {ι : Sort v} [Nonempty ι] (l : ι → MonoidLanguage M) (m : MonoidLanguage M) :
    (⨆ i, l i) + m = ⨆ i, l i + m :=
  iSup_sup

theorem add_iSup {ι : Sort v} [Nonempty ι] (l : ι → MonoidLanguage M) (m : MonoidLanguage M) :
    (m + ⨆ i, l i) = ⨆ i, m + l i :=
  sup_iSup

theorem iSup_sub {ι : Sort v} (l : ι → MonoidLanguage M) (m : MonoidLanguage M) :
    (⨆ i, l i) - m = ⨆ i, l i - m :=
  iUnion_sdiff _ _

theorem sub_iSup {ι : Sort v} [Nonempty ι] (l : ι → MonoidLanguage M) (m : MonoidLanguage M) :
    (m - ⨆ i, l i) = ⨅ i, m - l i :=
  sdiff_iUnion _ _

@[simp]
lemma mem_inf {x : M} {l m : MonoidLanguage M} : x ∈ l ⊓ m ↔ x ∈ l ∧ x ∈ m := by
  apply Set.mem_inter_iff

lemma compl_compl (l : MonoidLanguage M) : lᶜᶜ = l :=
  _root_.compl_compl l

@[simp]
theorem mem_biInf {I : Type*} (s : Set I) (l : I → MonoidLanguage M) (x : M) :
    (x ∈ ⨅ i ∈ s, l i) ↔ ∀ i ∈ s, x ∈ l i :=
  mem_iInter₂

@[simp]
theorem mem_biSup {I : Type*} (s : Set I) (l : I → MonoidLanguage M) (x : M) :
    (x ∈ ⨆ i ∈ s, l i) ↔ ∃ i ∈ s, x ∈ l i where
  mp h := bex_def.mp (mem_iUnion₂.mp h)
  mpr h := mem_iUnion₂.mpr (bex_def.mpr h)

@[simp, scoped grind =]
theorem mem_singleton (x y : M) : x ∈ ({y} : MonoidLanguage M) ↔ x = y :=
  Iff.rfl

/-! ## Results for an arbitrary monoid -/

section Monoid

variable [Monoid M] [Monoid N] [Monoid P]

/-- `1 : MonoidLanguage M` contains only one element `1`. -/
instance : One (MonoidLanguage M) :=
  ⟨{1}⟩

/-- The product of two languages `l` and `m` is the language made of the elements `x * y` where
`x ∈ l` and `y ∈ m`. -/
instance : Mul (MonoidLanguage M) :=
  ⟨image2 (· * ·)⟩

theorem one_def : (1 : MonoidLanguage M) = ({1} : Set M) :=
  rfl

theorem mul_def (l m : MonoidLanguage M) : l * m = image2 (· * ·) l m :=
  rfl

/-- The Kleene star of a language `l` is the set of all elements which can be written as
products of elements of `l`, i.e., the submonoid generated by `l`. -/
instance : KStar (MonoidLanguage M) := ⟨fun l ↦ {x | ∃ L : List M, x = L.prod ∧ ∀ y ∈ L, y ∈ l}⟩

lemma kstar_def (l : MonoidLanguage M) : l∗ = {x | ∃ L : List M, x = L.prod ∧ ∀ y ∈ L, y ∈ l} :=
  rfl

@[simp]
theorem mem_one (x : M) : x ∈ (1 : MonoidLanguage M) ↔ x = 1 := by rfl

theorem one_mem_one : (1 : M) ∈ (1 : MonoidLanguage M) :=
  Set.mem_singleton _

theorem mem_mul : x ∈ l * m ↔ ∃ a ∈ l, ∃ b ∈ m, a * b = x :=
  mem_image2

theorem mul_mem_mul : a ∈ l → b ∈ m → a * b ∈ l * m :=
  mem_image2_of_mem

theorem mem_kstar : x ∈ l∗ ↔ ∃ L : List M, x = L.prod ∧ ∀ y ∈ L, y ∈ l :=
  Iff.rfl

theorem prod_mem_kstar {L : List M} (h : ∀ y ∈ L, y ∈ l) : L.prod ∈ l∗ :=
  ⟨L, rfl, h⟩

theorem one_mem_kstar (l : MonoidLanguage M) : (1 : M) ∈ l∗ :=
  ⟨[], rfl, fun _ h ↦ by contradiction⟩

set_option backward.isDefEq.respectTransparency false in
instance instSemiring : Semiring (MonoidLanguage M) where
  add_assoc := union_assoc
  zero_add := empty_union
  add_zero := union_empty
  add_comm := union_comm
  mul_assoc _ _ _ := image2_assoc mul_assoc
  zero_mul _ := image2_empty_left
  mul_zero _ := image2_empty_right
  one_mul l := by simp [mul_def, one_def]
  mul_one l := by simp [mul_def, one_def]
  natCast n := if n = 0 then 0 else 1
  natCast_zero := rfl
  natCast_succ n := by cases n <;> simp [add_def, zero_def]
  left_distrib _ _ _ := image2_union_right
  right_distrib _ _ _ := image2_union_left
  nsmul := nsmulRec

/-- Maps a language along a monoid homomorphism. -/
def map (f : M →* N) : MonoidLanguage M →+* MonoidLanguage N where
  toFun := image f
  map_zero' := image_empty _
  map_one' := by
    change f '' {1} = {1}
    rw [image_singleton, map_one]
  map_add' := image_union _
  map_mul' _ _ := image_image2_distrib <| fun _ _ => map_mul f _ _

set_option backward.isDefEq.respectTransparency false in
@[simp]
theorem map_id (l : MonoidLanguage M) : map (MonoidHom.id M) l = l := by simp [map]

set_option backward.isDefEq.respectTransparency false in
@[simp]
theorem map_map (g : N →* P) (f : M →* N) (l : MonoidLanguage M) :
    map g (map f l) = map (g.comp f) l := by
  simp [map, image_image]

open Classical in
/-- Dropping the `1`s from a list does not change its product. -/
private lemma prod_filter_ne_one (L : List M) :
    (L.filter (fun y ↦ decide (y ≠ 1))).prod = L.prod := by
  induction L with
  | nil => rfl
  | cons a L ih =>
    by_cases ha : a = 1
    · rw [filter_cons_of_neg (by simpa using ha), ih, prod_cons, ha, one_mul]
    · rw [filter_cons_of_pos (by simpa using ha), prod_cons, prod_cons, ih]

open Classical in
lemma mem_kstar_iff_exists_nonempty {x : M} :
    x ∈ l∗ ↔ ∃ S : List M, x = S.prod ∧ ∀ y ∈ S, y ∈ l ∧ y ≠ 1 := by
  constructor
  · rintro ⟨S, rfl, h⟩
    refine ⟨S.filter (fun y ↦ decide (y ≠ 1)), (prod_filter_ne_one S).symm, fun y hy ↦ ?_⟩
    rw [mem_filter, decide_eq_true_iff] at hy
    exact ⟨h y hy.1, hy.2⟩
  · rintro ⟨S, hx, h⟩
    exact ⟨S, hx, fun y hy ↦ (h y hy).1⟩

theorem kstar_def_nonempty (l : MonoidLanguage M) :
    l∗ = { x | ∃ S : List M, x = S.prod ∧ ∀ y ∈ S, y ∈ l ∧ y ≠ 1 } := by
  ext x; apply mem_kstar_iff_exists_nonempty

instance : MulLeftMono (MonoidLanguage M) where
  elim _ _ _ := image2_subset_left

instance : MulRightMono (MonoidLanguage M) where
  elim _ _ _ := image2_subset_right

theorem iSup_mul {ι : Sort v} (l : ι → MonoidLanguage M) (m : MonoidLanguage M) :
    (⨆ i, l i) * m = ⨆ i, l i * m :=
  image2_iUnion_left _ _ _

theorem mul_iSup {ι : Sort v} (l : ι → MonoidLanguage M) (m : MonoidLanguage M) :
    (m * ⨆ i, l i) = ⨆ i, m * l i :=
  image2_iUnion_right _ _ _

theorem mem_pow {l : MonoidLanguage M} {x : M} {n : ℕ} :
    x ∈ l ^ n ↔ ∃ S : List M, x = S.prod ∧ S.length = n ∧ ∀ y ∈ S, y ∈ l := by
  induction n generalizing x with
  | zero => simp
  | succ n ihn =>
    simp only [pow_succ', mem_mul, ihn]
    constructor
    · rintro ⟨a, ha, b, ⟨S, rfl, rfl, hS⟩, rfl⟩
      exact ⟨a :: S, prod_cons.symm, rfl, forall_mem_cons.2 ⟨ha, hS⟩⟩
    · rintro ⟨_ | ⟨a, S⟩, rfl, hn, hS⟩ <;> cases hn
      rw [forall_mem_cons] at hS
      exact ⟨a, hS.1, _, ⟨S, rfl, rfl, hS.2⟩, prod_cons.symm⟩

theorem kstar_eq_iSup_pow (l : MonoidLanguage M) : l∗ = ⨆ i : ℕ, l ^ i := by
  ext x
  simp only [mem_kstar, mem_iSup, mem_pow]
  grind

@[simp]
theorem map_kstar (f : M →* N) (l : MonoidLanguage M) : map f l∗ = (map f l)∗ := by
  rw [kstar_eq_iSup_pow, kstar_eq_iSup_pow]
  simp_rw [← map_pow]
  exact image_iUnion

theorem mul_self_kstar_comm (l : MonoidLanguage M) : l∗ * l = l * l∗ := by
  simp only [kstar_eq_iSup_pow, mul_iSup, iSup_mul, ← pow_succ, ← pow_succ']

@[simp]
theorem one_add_self_mul_kstar_eq_kstar (l : MonoidLanguage M) : 1 + l * l∗ = l∗ := by
  simp only [kstar_eq_iSup_pow, mul_iSup, ← pow_succ', ← pow_zero l]
  exact sup_iSup_nat_succ _

@[simp]
theorem one_add_kstar_mul_self_eq_kstar (l : MonoidLanguage M) : 1 + l∗ * l = l∗ := by
  rw [mul_self_kstar_comm, one_add_self_mul_kstar_eq_kstar]

instance : KleeneAlgebra (MonoidLanguage M) where
  __ : OrderBot (MonoidLanguage M) := inferInstance
  one_le_kstar a _ hl := ⟨[], hl, by simp⟩
  mul_kstar_le_kstar a := (one_add_self_mul_kstar_eq_kstar a).le.trans' le_sup_right
  kstar_mul_le_kstar a := (one_add_kstar_mul_self_eq_kstar a).le.trans' le_sup_right
  kstar_mul_le_self l m h := by
    rw [kstar_eq_iSup_pow, iSup_mul]
    refine iSup_le fun n ↦ ?_
    induction n with
    | zero => simp
    | succ n ih => grw [pow_succ, mul_assoc, h, ih]
  mul_kstar_le_self l m h := by
    rw [kstar_eq_iSup_pow, mul_iSup]
    refine iSup_le fun n ↦ ?_
    induction n with
    | zero => simp
    | succ n ih => grw [pow_succ, ← mul_assoc m (l ^ n) l, ih, h]

theorem le_one_iff_eq : l ≤ 1 ↔ l = 0 ∨ l = 1 :=
  subset_singleton_iff_eq

/-- `0` and `1` are the only possible languages over a trivial monoid. -/
theorem eq_zero_or_one_of_subsingleton [Subsingleton M] (l : MonoidLanguage M) :
    l = 0 ∨ l = 1 := by
  by_cases h : l = 0
  · exact Or.inl h
  · right
    ext x
    obtain ⟨y, hy⟩ := nonempty_iff_ne_empty.mpr h
    exact ⟨fun _ ↦ (mem_one x).mpr (Subsingleton.elim x 1), fun _ ↦ Subsingleton.elim y x ▸ hy⟩

@[simp, scoped grind =]
theorem mem_sub_one (x : M) : x ∈ (l - 1) ↔ x ∈ l ∧ x ≠ 1 :=
  Iff.rfl

@[scoped grind =]
theorem sub_one_kstar : (l - 1)∗ = l∗ := by
  ext x
  grind [mem_kstar, mem_kstar_iff_exists_nonempty]

/-! ### The `sub_one` lemmas, assuming that `1` has no nontrivial factorization -/

section NoFactorOne

variable [IsDedekindFiniteMonoid M] [Subsingleton Mˣ]

@[scoped grind =]
theorem sub_one_mul : (l - 1) * l = l * l - 1 := by
  ext x
  rw [mem_mul, mem_sub, mem_mul]
  constructor
  · rintro ⟨u, ⟨h_u, h_u1⟩, v, h_v, rfl⟩
    exact ⟨⟨u, h_u, v, h_v, rfl⟩, fun h ↦ h_u1 (mul_eq_one.mp h).1⟩
  · rintro ⟨⟨u, h_u, v, h_v, rfl⟩, h_x⟩
    rcases eq_or_ne u 1 with (rfl | h_u')
    · rw [one_mul] at h_x
      exact ⟨v, ⟨h_v, h_x⟩, 1, h_u, (mul_one v).trans (one_mul v).symm⟩
    · exact ⟨u, ⟨h_u, h_u'⟩, v, h_v, rfl⟩

@[scoped grind =]
theorem mul_sub_one : l * (l - 1) = l * l - 1 := by
  ext x
  rw [mem_mul, mem_sub, mem_mul]
  constructor
  · rintro ⟨u, h_u, v, ⟨h_v, h_v1⟩, rfl⟩
    exact ⟨⟨u, h_u, v, h_v, rfl⟩, fun h ↦ h_v1 (mul_eq_one.mp h).2⟩
  · rintro ⟨⟨u, h_u, v, h_v, rfl⟩, h_x⟩
    rcases eq_or_ne v 1 with (rfl | h_v')
    · rw [mul_one] at h_x
      exact ⟨1, h_v, u, ⟨h_u, h_x⟩, (one_mul u).trans (mul_one u).symm⟩
    · exact ⟨u, h_u, v, ⟨h_v, h_v'⟩, rfl⟩

@[scoped grind =]
theorem kstar_sub_one : l∗ - 1 = (l - 1) * l∗ := by
  ext x; constructor
  · rintro ⟨h1, h2⟩
    obtain ⟨S, rfl, h_S⟩ := mem_kstar_iff_exists_nonempty.mp h1
    obtain _ | ⟨y, S'⟩ := S
    · exact absurd one_mem_one h2
    · rw [forall_mem_cons] at h_S
      exact ⟨y, h_S.1, S'.prod, prod_mem_kstar fun z hz ↦ (h_S.2 z hz).1, prod_cons.symm⟩
  · rintro ⟨y, ⟨h_y, h_y1⟩, z, h_z, rfl⟩
    refine ⟨?_, fun h ↦ h_y1 (mul_eq_one.mp h).1⟩
    apply (show l * l∗ ≤ l∗ by exact mul_kstar_le_kstar)
    exact ⟨y, h_y, z, h_z, rfl⟩

end NoFactorOne

/-! ### Arden's lemma, assuming a well-foundedness condition -/

/-- `StrictRightFactor y x` means that `x = a * y` for some `a ≠ 1`. -/
def StrictRightFactor (y x : M) : Prop :=
  ∃ a, a ≠ 1 ∧ x = a * y

/-- `StrictLeftFactor y x` means that `x = y * a` for some `a ≠ 1`. -/
def StrictLeftFactor (y x : M) : Prop :=
  ∃ a, a ≠ 1 ∧ x = y * a

/-- **Arden's lemma**, assuming that `StrictRightFactor` is well-founded. -/
theorem self_eq_mul_add_iff (hw : WellFounded (StrictRightFactor (M := M)))
    {l m n : MonoidLanguage M} (hm : 1 ∉ m) : l = m * l + n ↔ l = m∗ * n where
  mp h := by
    apply le_antisymm
    · intro x hx
      induction x using hw.induction with | _ x ih
      rw [h] at hx
      obtain hx | hx := hx
      · obtain ⟨a, ha, b, hb, rfl⟩ := mem_mul.mp hx
        have hb' := ih b ⟨a, ne_of_mem_of_not_mem ha hm, rfl⟩ hb
        rw [← one_add_self_mul_kstar_eq_kstar, one_add_mul, mul_assoc]
        right
        exact ⟨_, ha, _, hb', rfl⟩
      · exact ⟨1, one_mem_kstar _, _, hx, one_mul _⟩
    · rw [kstar_eq_iSup_pow, iSup_mul, iSup_le_iff]
      intro i
      induction i with rw [h]
      | zero =>
        rw [pow_zero, one_mul, add_comm]
        exact le_self_add
      | succ _ ih =>
        grw [add_comm, pow_add, pow_one, mul_assoc, ih]
        exact le_self_add
  mpr h := by rw [h, add_comm, ← mul_assoc, ← one_add_mul, one_add_self_mul_kstar_eq_kstar]

/-- The mirror image of Arden's lemma `MonoidLanguage.self_eq_mul_add_iff`,
assuming that `StrictLeftFactor` is well-founded. -/
theorem self_eq_add_mul_iff (hw : WellFounded (StrictLeftFactor (M := M)))
    {l m n : MonoidLanguage M} (hm : 1 ∉ m) : l = l * m + n ↔ l = n * m∗ where
  mp h := by
    apply le_antisymm
    · intro x hx
      induction x using hw.induction with | _ x ih
      rw [h] at hx
      obtain hx | hx := hx
      · obtain ⟨b, hb, a, ha, rfl⟩ := mem_mul.mp hx
        have hb' := ih b ⟨a, ne_of_mem_of_not_mem ha hm, rfl⟩ hb
        rw [← one_add_kstar_mul_self_eq_kstar, mul_add, mul_one, ← mul_assoc]
        right
        exact ⟨_, hb', _, ha, rfl⟩
      · exact ⟨_, hx, 1, one_mem_kstar _, mul_one _⟩
    · rw [kstar_eq_iSup_pow, mul_iSup, iSup_le_iff]
      intro i
      induction i with rw [h]
      | zero =>
        rw [pow_zero, mul_one]
        exact le_add_self
      | succ _ ih =>
        grw [pow_succ, ← mul_assoc, ih]
        exact le_self_add
  mpr h := by rw [h, add_comm, mul_assoc, ← mul_one_add, one_add_kstar_mul_self_eq_kstar]

@[scoped grind .]
theorem kstar_iff_mul_add (hw : WellFounded (StrictRightFactor (M := M))) :
    m = l∗ ↔ m = (l - 1) * m + 1 := by
  rw [self_eq_mul_add_iff hw (fun h ↦ ((mem_sub_one 1).mp h).2 rfl), mul_one, sub_one_kstar]

/-! ### Reversal along an involutive anti-automorphism -/

section Reverse

variable [StarMul M]

/-- Language `l.reverse` is the preimage (equivalently, the image) of `l` under `star`. -/
def reverse (l : MonoidLanguage M) : MonoidLanguage M := { w : M | star w ∈ l }

@[simp]
lemma mem_reverse : a ∈ l.reverse ↔ star a ∈ l := Iff.rfl

lemma reverse_mem_reverse : star a ∈ l.reverse ↔ a ∈ l := by
  rw [mem_reverse, star_star]

lemma reverse_eq_image (l : MonoidLanguage M) : l.reverse = star '' l :=
  ((star_involutive.toPerm _).image_eq_preimage_symm _).symm

@[simp]
lemma reverse_zero : (0 : MonoidLanguage M).reverse = 0 := rfl

@[simp]
lemma reverse_one : (1 : MonoidLanguage M).reverse = 1 := by
  ext x
  rw [mem_reverse, mem_one, mem_one]
  constructor
  · intro h
    rw [← star_star x, h, star_one]
  · intro h
    rw [h, star_one]

lemma reverse_involutive : Function.Involutive (reverse : MonoidLanguage M → _) :=
  star_involutive.preimage

lemma reverse_bijective : Function.Bijective (reverse : MonoidLanguage M → _) :=
  reverse_involutive.bijective

lemma reverse_injective : Function.Injective (reverse : MonoidLanguage M → _) :=
  reverse_involutive.injective

lemma reverse_surjective : Function.Surjective (reverse : MonoidLanguage M → _) :=
  reverse_involutive.surjective

@[simp]
lemma reverse_reverse (l : MonoidLanguage M) : l.reverse.reverse = l := reverse_involutive l

@[simp]
lemma reverse_add (l m : MonoidLanguage M) : (l + m).reverse = l.reverse + m.reverse := rfl

set_option backward.isDefEq.respectTransparency false in
@[simp]
lemma reverse_mul (l m : MonoidLanguage M) : (l * m).reverse = m.reverse * l.reverse := by
  simp only [mul_def, reverse_eq_image, image2_image_left, image2_image_right, image_image2,
    star_mul]
  apply image2_swap

@[simp]
lemma reverse_iSup {ι : Sort*} (l : ι → MonoidLanguage M) :
    (⨆ i, l i).reverse = ⨆ i, (l i).reverse :=
  preimage_iUnion

@[simp]
lemma reverse_iInf {ι : Sort*} (l : ι → MonoidLanguage M) :
    (⨅ i, l i).reverse = ⨅ i, (l i).reverse :=
  preimage_iInter

variable (M) in
/-- `MonoidLanguage.reverse` as a ring isomorphism to the opposite ring. -/
@[simps]
def reverseIso : MonoidLanguage M ≃+* (MonoidLanguage M)ᵐᵒᵖ where
  toFun l := .op l.reverse
  invFun l' := l'.unop.reverse
  left_inv := reverse_reverse
  right_inv l' := MulOpposite.unop_injective <| reverse_reverse l'.unop
  map_mul' l₁ l₂ := MulOpposite.unop_injective <| reverse_mul l₁ l₂
  map_add' l₁ l₂ := MulOpposite.unop_injective <| reverse_add l₁ l₂

@[simp]
lemma reverse_pow (l : MonoidLanguage M) (n : ℕ) : (l ^ n).reverse = l.reverse ^ n :=
  MulOpposite.op_injective (map_pow (reverseIso M) l n)

@[simp]
lemma reverse_kstar (l : MonoidLanguage M) : l∗.reverse = l.reverse∗ := by
  simp only [kstar_eq_iSup_pow, reverse_iSup, reverse_pow]

@[simp, scoped grind =]
theorem reverse_sub (l m : MonoidLanguage M) : (l - m).reverse = l.reverse - m.reverse := by
  ext x; simp [mem_sub]

end Reverse

end Monoid

end MonoidLanguage

end Cslib
